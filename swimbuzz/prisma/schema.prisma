generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum Role {
  COACH
  EXEC
  ATHLETE
}

enum Course {
  SCY
  LCM
  SCM
}

enum Gender {
  M
  F
}

enum BridgeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BridgeJobType {
  ROSTER
  TIMES_BULK
  SWIMPHONE_MEET
  PARSE_MEET_PDF
  PARSE_MEET_SHEET
  PARSE_MEET_PACKET
}


model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? 
  name          String?
  image         String?
  role          Role      @default(COACH)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  athlete       Athlete?
  practices     Practice[]
  comments      PracticeComment[]
}

model Athlete {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  nicknames    String[] @default([])
  gender       Gender
  seasons      String[]
  swimCloudId  Int?    
  timesSyncedAt DateTime?
  swims        Swim[]
  meetSignups  MeetSignupEntry[]
}

model Meet {
  id            String    @id @default(cuid())
  name          String
  location      String?
  startDate     DateTime
  endDate       DateTime?
  course        Course    @default(SCY)
  season        String
  teamCode      String    @default("GTSC")
  packetUrl     String?
  psychSheetUrl String?
  heatSheetUrl  String?
  entriesSheetUrl String?
  resultsUrl    String?
  liveStreamUrl String?
  rideSignUpsUrl String?
  roomsUrl       String?
  hotel          String?
  packingList    String?
  itinerary      String?
  eventOrder    Json?
  psychSheetSummary Json?
  heatSheetSummary  Json?
  entriesSheetSummary Json?
  relayResultsSummary Json?
  resultStatusesSummary Json?
  createdAt     DateTime  @default(now())
  swims         Swim[]
  signupForm    MeetSignupForm?
}

model MeetSignupForm {
  id              String            @id @default(cuid())
  meetId          String            @unique
  meet            Meet              @relation(fields: [meetId], references: [id], onDelete: Cascade)
  enabled         Boolean           @default(false)
  instructions    String            @default("")
  allowedEvents   String[]          @default([])
  minEvents       Int?
  maxEvents       Int?
  maxRelayEvents  Int?
  askNotes        Boolean           @default(true)
  customQuestions Json?
  openAt          DateTime?
  closeAt         DateTime?
  withdrawUntil   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  entries         MeetSignupEntry[]
}

model MeetSignupEntry {
  id        String         @id @default(cuid())
  formId    String
  form      MeetSignupForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  events    String[]       @default([])
  entryTimes Json?
  notes     String         @default("")
  answers   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([formId, athleteId])
  @@index([formId])
  @@index([athleteId])
}

model Swim {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  meet       String   @default("")
  meetId     String?
  meetRef    Meet?    @relation(fields: [meetId], references: [id], onDelete: SetNull)
  event      String
  timeMs     Int
  place      Int?
  tags       String   @default("")
  course     Course
  date       DateTime
  occurrence Int      @default(0)
  source     String
  createdAt  DateTime @default(now())

  @@unique([athleteId, event, timeMs, course, date, tags, occurrence])
  @@index([meetId])
}

model Practice {
  id          String        @id @default(cuid())
  title       String
  date        DateTime?
  focus       String?
  published   Boolean       @default(false)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sets        PracticeSet[]
  comments    PracticeComment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([date])
  @@index([published])
}

model PracticeSet {
  id         String       @id @default(cuid())
  practiceId String
  practice   Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  order      Int          @default(0)
  title      String?
  content    String
  notes      String?
  tags       String[]     @default([])
  distance   Int?
  createdAt  DateTime     @default(now())

  @@index([practiceId])
  @@index([tags])
}

model PracticeComment {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime  @default(now())

  @@index([practiceId])
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model BridgePairing {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BridgeConnection {
  id         String      @id @default(cuid())
  userId     String
  token      String      @unique
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  jobs       BridgeJob[]

  @@index([userId])
}

model BridgeJob {
  id           String            @id @default(cuid())
  userId       String
  connectionId String?
  connection   BridgeConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  type         BridgeJobType
  payload      Json
  status       BridgeJobStatus   @default(PENDING)
  result       Json?
  error        String?
  createdAt    DateTime          @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([userId, status])
  @@index([connectionId, status])
}