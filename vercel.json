{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @swimbuzz/web run build",
  "crons": [
    {
      "path": "/api/cron/notification-cleanup",
      "schedule": "0 8 * * *"
    }
  ]
}
