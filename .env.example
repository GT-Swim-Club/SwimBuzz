# Web env. Copy to apps/web/.env.

# --- Database (Postgres / Supabase) ---
# DATABASE_URL: pooler, port 6543, add ?pgbouncer=true&connection_limit=5
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# DIRECT_URL: direct, port 5432 — db push/migrations only
DIRECT_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Storage (meet files + avatars) ---
SUPABASE_URL=https://your-project.supabase.co
# service_role key, not anon
SUPABASE_SERVICE_ROLE_KEY=
# Create buckets "meet-files" and "avatars", then run apps/web/supabase/{meet-files,avatars}-storage.sql

# --- Auth (NextAuth + Google OAuth) ---
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_IOS_CLIENT_ID=      # optional, for mobile ID token aud checks
# GOOGLE_ANDROID_CLIENT_ID=

# --- Google Sheets roster import (Picker) ---
# Enable both "Google Picker API" and "Google Sheets API" in the API Library
NEXT_PUBLIC_GOOGLE_CLIENT_ID=       # same client as GOOGLE_CLIENT_ID, used client-side
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=  # separate API key, restrict to Picker API + your origins

# --- Email sign-in (Resend) ---
RESEND_API_KEY=              # resend.com; without it, OTP codes just log to the console
EMAIL_FROM= 

# --- SwimCloud ---
SWIMCLOUD_TEAM_ID=10004130

# --- Cron ---
CRON_SECRET=                 # openssl rand -base64 32; Bearer header for /api/cron/*

# --- Web server (local server.js only) ---
# HOSTNAME=0.0.0.0
# PORT=3000
# HTTP_REQUEST_TIMEOUT_MS=3600000
# SCRAPER_SYNC_WAIT=1         # force sync wait on scraper jobs (non-Vercel only)

# --- PDF parsing ---
PDF_PARSER_SECRET=            # openssl rand -base64 32
# PDF_PARSER_URL=              # production only; unset locally uses python3 -m pdf_parsers.cli

# --- Push (Expo) ---
# EXPO_ACCESS_TOKEN=

# --- Run Scraper (desktop helper, optional overrides) ---
# SWIMBUZZ_URL=https://swimbuzz.gtswimclub.com
# BRIDGE_PAIRING_CODE=123456
# PLAYWRIGHT_HEADLESS=false
