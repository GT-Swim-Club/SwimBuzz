# Copy to swimbuzz/.env and fill in values.

# --- Database (PostgreSQL / Supabase) ---
# DIRECT_URL: direct connection — used by Prisma migrations and db push
DIRECT_URL=postgresql://user:password@host:5432/postgres
# DATABASE_URL: pooled connection (PgBouncer) — optional if you only use DIRECT_URL
DATABASE_URL=

# --- Supabase (meet files + profile avatars) ---
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role secret — NOT the anon/public key
SUPABASE_SERVICE_ROLE_KEY=
# Create public buckets "meet-files" and "avatars", then run
# supabase/meet-files-storage.sql and supabase/avatars-storage.sql

# --- Auth (NextAuth + Google OAuth) ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000 — production: https://your-app.onrender.com
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email sign-in (Resend) ---
# Create an API key at https://resend.com — required in production
RESEND_API_KEY=
# Verified sender, e.g. SwimBuzz <noreply@yourdomain.com>
# Dev fallback without a key logs the code to the server console
EMAIL_FROM=SwimBuzz <onboarding@resend.dev>

# --- SwimCloud ---
SWIMCLOUD_TEAM_ID=10004130

# --- Web server (optional) ---
# HOSTNAME=0.0.0.0
# PORT=3000
# HTTP_REQUEST_TIMEOUT_MS=3600000

# --- Run scraper (on your computer; optional overrides) ---
# SWIMBUZZ_URL=https://your-app.onrender.com
# BRIDGE_PAIRING_CODE=123456
# PLAYWRIGHT_HEADLESS=false
