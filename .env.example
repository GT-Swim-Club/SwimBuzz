# Copy to apps/web/.env and fill in values.

# --- Database (PostgreSQL / Supabase) ---
# DATABASE_URL: transaction-mode pooler (port 6543) — required for Vercel serverless
# Add ?pgbouncer=true&connection_limit=5 for Prisma + Supabase
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# DIRECT_URL: session/direct (port 5432) — migrations and db push only (not app queries)
DIRECT_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase (meet files + profile avatars) ---
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role secret — NOT the anon/public key
SUPABASE_SERVICE_ROLE_KEY=
# Create public buckets "meet-files" and "avatars", then run
# supabase/meet-files-storage.sql and supabase/avatars-storage.sql

# --- Auth (NextAuth + Google OAuth) ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000 — production: https://swimbuzz.gtswimclub.com
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional mobile Google OAuth client IDs (aud check for ID tokens)
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# --- Google Sheets roster import (Picker) ---
# In the API Library, enable BOTH "Google Picker API" (for the file picker)
# AND "Google Sheets API" (for the backend reads in google-sheets.ts) — they
# are separate APIs and a missing Sheets API enablement fails as a 403 on
# every sheet, not just some.
# Public duplicate of GOOGLE_CLIENT_ID — OAuth client IDs are not secret and
# this one runs client-side (Google Identity Services' token client).
# Requires "Authorized JavaScript origins" (not just redirect URIs) on that
# OAuth client for each origin this runs from (localhost:3000, prod).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Separate credential (Google Cloud Console → Credentials → API key), NOT the
# OAuth client secret. Restrict: HTTP referrers = your origins, API
# restriction = "Google Picker API" (enable it in the API Library first).
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# --- Email sign-in (Resend) ---
# Create an API key at https://resend.com — required in production
RESEND_API_KEY=
# Verified sender, e.g. SwimBuzz <noreply@yourdomain.com>
# Dev fallback without a key logs the code to the server console
EMAIL_FROM=SwimBuzz <onboarding@resend.dev>

# --- SwimCloud ---
SWIMCLOUD_TEAM_ID=10004130

# --- Cron (Vercel + external signup monitor) ---
# Generate: openssl rand -base64 32
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# External cron (every minute) must send the same header to /api/cron/signup-monitor
CRON_SECRET=

# --- Web server (optional, local custom server.js only) ---
# HOSTNAME=0.0.0.0
# PORT=3000
# HTTP_REQUEST_TIMEOUT_MS=3600000
# Force sync wait for scraper jobs on a long-lived Node process (not Vercel):
# SCRAPER_SYNC_WAIT=1

# --- Push (Expo) ---
# EXPO_ACCESS_TOKEN=

# --- Run scraper (on your computer; optional overrides) ---
# SWIMBUZZ_URL=https://swimbuzz.gtswimclub.com
# BRIDGE_PAIRING_CODE=123456
# PLAYWRIGHT_HEADLESS=false

# --- Mobile app (copy to apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# Public web origin, used to build shareable links and the hosted Google
# Sheets picker page (google-sheets-picker) mobile opens for roster import.
# EXPO_PUBLIC_WEB_URL=http://192.168.x.x:3000
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
