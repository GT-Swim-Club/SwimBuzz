# Copy to swimbuzz/.env and fill in values.

# --- Database (PostgreSQL / Supabase) ---
# DIRECT_URL: direct connection — used by Prisma migrations and db push
DIRECT_URL=postgresql://user:password@host:5432/postgres
# DATABASE_URL: pooled connection (PgBouncer) — optional if you only use DIRECT_URL
DATABASE_URL=

# --- Supabase (meet file storage) ---
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role secret — NOT the anon/public key
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (NextAuth + Google OAuth) ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000 — production: https://your-app.onrender.com
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scraper (FastAPI + Playwright, run separately) ---
SCRAPER_URL=http://localhost:8000

# --- SwimCloud ---
SWIMCLOUD_TEAM_ID=10004130

# --- Web server (optional) ---
# HOSTNAME=0.0.0.0
# PORT=3000
# HTTP_REQUEST_TIMEOUT_MS=3600000
# SCRAPER_FETCH_TIMEOUT_MS=3600000

# --- Scraper service only (scraper/.env or Render env on swimbuzz-scraper) ---
# Comma-separated web app origins allowed to call the scraper API
# CORS_ORIGINS=http://localhost:3000,https://your-app.onrender.com
# PLAYWRIGHT_HEADLESS=false
# SWIMBUZZ_URL=https://swimbuzz.onrender.com
# BRIDGE_PAIRING_CODE=123456
