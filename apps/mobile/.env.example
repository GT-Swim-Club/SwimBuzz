# Mobile env vars. Copy to apps/mobile/.env.
# (Web has its own file: .env.example at repo root -> apps/web/.env)

# Use your Mac's LAN IP when testing on a physical phone (not localhost / 127.0.0.1).
# Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.73:3000
EXPO_PUBLIC_WEB_URL=https://swimbuzz.gtswimclub.com

# Optional — Google sign-in (development builds only; blocked in Expo Go).
# Create separate OAuth clients in Google Cloud Console:
#   - Web   → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (same as apps/web GOOGLE_CLIENT_ID)
#   - iOS   → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (bundle: com.gtswimclub.swimbuzz)
#   - Android → EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID (package + SHA-1)
# Do NOT reuse the web client ID for iOS/Android — Google will reject it.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
